msgstr "Ne (klasični shortcode [woocommerce_checkout])"

#, php-format
msgid "Block checkout fields only appear if the Checkout page actually contains the WooCommerce checkout block. <a href=\"%s\">Edit checkout page</a>."
msgstr "Polja block blagajne pojavljuju se samo ako stranica blagajne stvarno sadrži WooCommerce blok blagajne. <a href=\"%s\">Uredi stranicu blagajne</a>."

msgid "Block checkout fields only appear if the Checkout page actually contains the WooCommerce checkout block."
msgstr "Polja block blagajne pojavljuju se samo ako stranica blagajne stvarno sadrži WooCommerce blok blagajne."

msgid "Hook fired this request"
msgstr "Hook se izvršio u ovom zahtjevu"

msgid "Yes, register_block_fields() was called"
msgstr "Da, register_block_fields() je pozvan"

msgid "No - woocommerce_init never reached our handler"
msgstr "Ne - woocommerce_init nije došao do našeg handlera"

msgid "If No, another plugin or fatal error is preventing woocommerce_init from running through to our handler. Check the WP debug.log."
msgstr "Ako je Ne, drugi plugin ili fatalna greška sprečava da woocommerce_init dođe do našeg handlera. Pogledajte WP debug.log."

