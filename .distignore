# Files left out of the wordpress.org build (bin/build-wporg.sh).
# The GitHub release (.github/workflows/release.yml) has its own list
# and keeps vendor/plugin-update-checker.
.git
.github
.wordpress-org
.distignore
.gitignore
.gitattributes
.idea
.vscode
/bin
/build
node_modules
/vendor
composer.json
composer.lock
CONTRIBUTING.md
README.md
*.zip
*.tar.gz
.DS_Store
Thumbs.db
# The translations ship as compiled .mo files (bin/build-wporg.sh builds them):
# translate.wordpress.org has no Croatian for the plugin, and without them the
# plugin shows English on a Croatian site.
languages/*.po
languages/*.pot
languages/*.mo
